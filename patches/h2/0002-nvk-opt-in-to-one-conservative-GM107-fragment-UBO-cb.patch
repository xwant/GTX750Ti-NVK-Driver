diff --git a/src/nouveau/vulkan/test_nvk_gm107_ubo.c b/src/nouveau/vulkan/test_nvk_gm107_ubo.c
new file mode 100644
index 00000000..eb3a5d02
--- /dev/null
+++ b/src/nouveau/vulkan/test_nvk_gm107_ubo.c
@@ -0,0 +1,213 @@
+/* SPDX-License-Identifier: MIT */
+#include "clb097.h"
+#include "nir_builder.h"
+#include "nir_serialize.h"
+#include "nvk_descriptor_set_layout.h"
+#include "nvk_device.h"
+#include "nvk_instance.h"
+#include "nvk_physical_device.h"
+#include "nvk_shader.h"
+#include "util/blob.h"
+#include "vk_alloc.h"
+#include "vk_pipeline.h"
+#include <stdio.h>
+#define CHECK(x)                                                                                   \
+   do {                                                                                            \
+      if (!(x)) {                                                                                  \
+         fprintf(stderr, "FAIL %d: %s\n", __LINE__, #x);                                           \
+         abort();                                                                                  \
+      }                                                                                            \
+   } while (0)
+struct fixture {
+   struct nvk_instance instance;
+   struct nvk_physical_device pdev;
+   struct nvk_device dev;
+   struct nvk_descriptor_set_layout *layout;
+   struct vk_pipeline_robustness_state rs;
+};
+struct options {
+   unsigned loads, ordinary, dynamic, offset, index;
+   bool dynamic_offset, dynamic_index, mixed, mutable, push;
+   mesa_shader_stage stage;
+};
+static nir_shader *make_shader(struct fixture *f, struct options o) {
+   unsigned bindings = o.ordinary + o.dynamic;
+   free(f->layout);
+   f->layout = calloc(1, sizeof(*f->layout) + bindings * sizeof(f->layout->binding[0]));
+   CHECK(f->layout);
+   f->layout->binding_count = bindings;
+   f->layout->vk.dynamic_descriptor_count = o.dynamic;
+   if (o.push)
+      f->layout->flags = VK_DESCRIPTOR_SET_LAYOUT_CREATE_PUSH_DESCRIPTOR_BIT_KHR;
+   nir_builder b = nir_builder_init_simple_shader(o.stage, nak_nir_options(f->pdev.nak), "h2-test");
+   nir_address_format fmt = nvk_ubo_addr_format(&f->pdev, &f->rs);
+   const struct glsl_type *array = glsl_array_type(glsl_uint_type(), 8192, 16);
+   nir_def *sum = nir_imm_int(&b, 0);
+   for (unsigned n = 0; n < bindings; n++) {
+      bool dyn = n >= o.ordinary;
+      f->layout->binding[n] = (struct nvk_descriptor_set_binding_layout){
+          .type = dyn         ? VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER_DYNAMIC
+                  : o.mutable ? VK_DESCRIPTOR_TYPE_MUTABLE_EXT
+                              : VK_DESCRIPTOR_TYPE_UNIFORM_BUFFER,
+          .array_size = 2,
+          .stride = 16,
+          .offset = n * 32,
+          .dynamic_buffer_index = dyn ? n - o.ordinary : 0};
+      nir_def *idx = o.dynamic_index ? nir_load_subgroup_invocation(&b) : nir_imm_int(&b, o.index);
+      nir_def *resource = nir_vulkan_resource_index(
+          &b, nir_address_format_num_components(fmt), nir_address_format_bit_size(fmt), idx,
+          .desc_set = 0, .binding = n, .desc_type = nir_descriptor_type_uniform_buffer,
+          .resource_type = nir_resource_type_uniform_buffer);
+      nir_def *addr = nir_load_vulkan_descriptor(&b, nir_address_format_num_components(fmt),
+                                                 nir_address_format_bit_size(fmt), resource,
+                                                 .desc_type = nir_descriptor_type_uniform_buffer);
+      nir_deref_instr *base =
+          nir_build_deref_cast_with_alignment(&b, addr, nir_var_mem_ubo, array, 0, 16, 0);
+      for (unsigned i = 0; i < o.loads; i++) {
+         nir_def *element = (o.dynamic_offset || (o.mixed && i == 0))
+                                ? nir_load_subgroup_invocation(&b)
+                                : nir_imm_int(&b, o.offset / 16 + i);
+         sum = nir_iadd(&b, sum, nir_load_deref(&b, nir_build_deref_array(&b, base, element)));
+      }
+   }
+   if (o.stage == MESA_SHADER_COMPUTE) {
+      b.shader->info.shared_size = 4;
+      nir_store_shared(&b, sum, nir_imm_int(&b, 0), .align_mul = 4);
+   } else
+      nir_store_output(&b, sum, nir_imm_int(&b, 0), .write_mask = 1, .src_type = nir_type_uint32,
+                       .io_semantics = {.location = o.stage == MESA_SHADER_FRAGMENT
+                                                        ? FRAG_RESULT_DATA0
+                                                        : VARYING_SLOT_VAR0,
+                                        .num_slots = 1});
+   nir_validate_shader(b.shader, "fixture");
+   return b.shader;
+}
+static unsigned count_loads(nir_shader *s) {
+   unsigned count = 0;
+   nir_foreach_function_impl(impl, s) nir_foreach_block(block, impl) nir_foreach_instr(
+       i, block) if (i->type == nir_instr_type_intrinsic &&
+                     nir_instr_as_intrinsic(i)->intrinsic == nir_intrinsic_load_ubo) count++;
+   return count;
+}
+static void lower(struct fixture *f, nir_shader *s, uint32_t flags, struct nvk_cbuf_map *map) {
+   struct vk_descriptor_set_layout *layouts[] = {&f->layout->vk};
+   nvk_nir_lower_descriptors(s, &f->pdev, flags, &f->rs, 1, layouts, map);
+   nir_validate_shader(s, "actual NVK lowering");
+}
+static void check(struct fixture *f, const char *name, struct options o, uint32_t debug,
+                  uint32_t flags, unsigned extra) {
+   f->pdev.debug_flags = 0;
+   nir_shader *a = make_shader(f, o), *b = nir_shader_clone(NULL, a);
+   struct nvk_cbuf_map ma = {0}, mb = {0};
+   lower(f, a, flags, &ma);
+   f->pdev.debug_flags = debug;
+   lower(f, b, flags, &mb);
+   CHECK(mb.cbuf_count == ma.cbuf_count + extra);
+   CHECK(memcmp(ma.cbufs, mb.cbufs, ma.cbuf_count * sizeof(ma.cbufs[0])) == 0);
+   if (extra)
+      CHECK(count_loads(b) == count_loads(a) + o.loads);
+   else {
+      struct blob ba, bb;
+      blob_init(&ba);
+      blob_init(&bb);
+      nir_serialize(&ba, a, true);
+      nir_serialize(&bb, b, true);
+      CHECK(ba.size == bb.size && memcmp(ba.data, bb.data, ba.size) == 0);
+      blob_finish(&ba);
+      blob_finish(&bb);
+   }
+   ralloc_free(a);
+   ralloc_free(b);
+   printf("PASS %s\n", name);
+}
+static void compiler_check(struct fixture *f, struct options o) {
+   struct nvk_shader *sh[2];
+   for (unsigned on = 0; on < 2; on++) {
+      f->pdev.debug_flags = on ? NVK_DEBUG_GM107_UBO_CBUF : 0;
+      nir_shader *nir = make_shader(f, o);
+      nvk_device_shader_ops.preprocess_nir(&f->pdev.vk, nir, &f->rs);
+      struct vk_descriptor_set_layout *layouts[] = {&f->layout->vk};
+      struct vk_shader_compile_info info = {.stage = o.stage,
+                                            .nir = nir,
+                                            .robustness = &f->rs,
+                                            .flags = VK_SHADER_CREATE_NO_TASK_SHADER_BIT_EXT,
+                                            .set_layout_count = 1,
+                                            .set_layouts = layouts};
+      struct vk_shader *out;
+      CHECK(nvk_device_shader_ops.compile(&f->dev.vk, 1, &info, NULL, NULL, NULL, &out) ==
+            VK_SUCCESS);
+      sh[on] = container_of(out, struct nvk_shader, vk);
+      CHECK(sh[on]->code_size > 0);
+   }
+   CHECK(sh[1]->cbuf_map.cbuf_count == sh[0]->cbuf_map.cbuf_count + 1);
+   printf("PASS SM50 compilation: off %u instructions/%u GPR, on %u instructions/%u GPR; not GPU "
+          "performance\n",
+          sh[0]->info.num_instrs, sh[0]->info.num_gprs, sh[1]->info.num_instrs,
+          sh[1]->info.num_gprs);
+   for (unsigned i = 0; i < 2; i++)
+      sh[i]->vk.ops->destroy(&f->dev.vk, &sh[i]->vk, NULL);
+}
+int main(void) {
+   glsl_type_singleton_init_or_ref();
+   struct fixture f = {0};
+   f.pdev.info = (struct nv_device_info){
+       .chipset = 0x117, .sm = 50, .cls_eng3d = MAXWELL_A, .max_warps_per_mp = 64};
+   f.pdev.vk.instance = &f.instance.vk;
+   f.pdev.nak = nak_compiler_create(&f.pdev.info);
+   CHECK(f.pdev.nak);
+   f.dev.vk.physical = &f.pdev.vk;
+   f.dev.vk.alloc = *vk_default_allocator();
+   f.dev.vk.base.type = VK_OBJECT_TYPE_DEVICE;
+   f.rs = (struct vk_pipeline_robustness_state){
+       .uniform_buffers = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_ROBUST_BUFFER_ACCESS_EXT,
+       .storage_buffers = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_ROBUST_BUFFER_ACCESS_EXT,
+       .images = VK_PIPELINE_ROBUSTNESS_IMAGE_BEHAVIOR_ROBUST_IMAGE_ACCESS_2_EXT};
+   const struct options normal = {.loads = 8, .ordinary = 1, .stage = MESA_SHADER_FRAGMENT};
+   const unsigned on = NVK_DEBUG_GM107_UBO_CBUF;
+   struct options o;
+   check(&f, "off", normal, 0, 0, 0);
+   check(&f, "C0 only", normal, NVK_DEBUG_GM107_UBO_DIAG, 0, 0);
+   check(&f, "eight reads", normal, on, 0, 1);
+   check(&f, "no_cbuf precedence", normal, on | NVK_DEBUG_NO_CBUF, 0, 0);
+   f.pdev.info.chipset = 0x120;
+   check(&f, "other GPU", normal, on, 0, 0);
+   f.pdev.info.chipset = 0x117;
+#define CASE(name, field, value, extra)                                                            \
+   o = normal;                                                                                     \
+   o.field = value;                                                                                \
+   check(&f, name, o, on, 0, extra)
+   CASE("seven reads", loads, 7, 0);
+   CASE("vertex", stage, MESA_SHADER_VERTEX, 0);
+   CASE("compute", stage, MESA_SHADER_COMPUTE, 0);
+   CASE("constant array index", index, 1, 1);
+   CASE("out-of-layout index", index, 2, 0);
+   CASE("dynamic index", dynamic_index, true, 0);
+   CASE("dynamic offset", dynamic_offset, true, 0);
+   CASE("mixed offset", mixed, true, 0);
+   CASE("mutable", mutable, true, 0);
+   CASE("push", push, true, 1);
+   CASE("outside window", offset, NVK_MAX_CBUF_SIZE, 0);
+   CASE("last valid window", offset, NVK_MAX_CBUF_SIZE - 128, 1);
+   CASE("only one extra", ordinary, 2, 1);
+   CASE("preserve dynamic slots", dynamic, 2, 1);
+   CASE("full map", dynamic, 15, 0);
+   check(&f, "indirect bind", normal, on, VK_SHADER_CREATE_INDIRECT_BINDABLE_BIT_EXT, 0);
+   f.rs.uniform_buffers = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_ROBUST_BUFFER_ACCESS_2_EXT;
+   check(&f, "robust2", normal, on, 0, 0);
+   f.rs.uniform_buffers = VK_PIPELINE_ROBUSTNESS_BUFFER_BEHAVIOR_ROBUST_BUFFER_ACCESS_EXT;
+   f.pdev.debug_flags = 0;
+   uint64_t flags = nvk_physical_device_compiler_flags(&f.pdev);
+   f.pdev.debug_flags = on;
+   CHECK((flags ^ nvk_physical_device_compiler_flags(&f.pdev)) == (UINT64_C(1) << 15));
+   f.pdev.info.chipset = 0x120;
+   CHECK(flags == nvk_physical_device_compiler_flags(&f.pdev));
+   f.pdev.info.chipset = 0x117;
+   f.pdev.debug_flags = on | NVK_DEBUG_NO_CBUF;
+   CHECK(!(nvk_physical_device_compiler_flags(&f.pdev) & (UINT64_C(1) << 15)));
+   puts("PASS effective cache flags");
+   compiler_check(&f, normal);
+   free(f.layout);
+   nak_compiler_destroy(f.pdev.nak);
+   glsl_type_singleton_decref();
+   return 0;
+}
