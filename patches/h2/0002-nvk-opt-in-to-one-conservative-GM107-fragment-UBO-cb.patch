+++ b/src/nouveau/vulkan/nvk_nir_lower_descriptors.c
@@ -70,7 +70,7 @@ struct lower_descriptors_ctx {
 
    struct hash_table *cbufs;
    struct nvk_cbuf_map *cbuf_map;
-   bool gm107_analyze, gm107_diag, gm107_no_cbuf, gm107_robust2;
+   bool gm107_promote, gm107_analyze, gm107_diag, gm107_no_cbuf, gm107_robust2;
    uint32_t gm107_loads, gm107_unknown, gm107_dynamic_ubos;
    char gm107_hash[BLAKE3_HEX_LEN];
 };
@@ -554,7 +554,18 @@ build_cbuf_map(nir_shader *nir, struct lower_descriptors_ctx *ctx)
       ctx->cbuf_map->cbufs[ctx->cbuf_map->cbuf_count++] = cbufs[i].key;
    }
 
-   gm107_report(ctx, cbufs, num_cbufs, -1);
+   /* Append only after upstream has selected all of its slots. */
+   int selected = -1;
+   if (ctx->gm107_promote && !ctx->gm107_robust2 && !ctx->gm107_unknown &&
+       ctx->cbuf_map->cbuf_count < max_cbuf_bindings) {
+      for (unsigned i = 0; i < num_cbufs; i++) {
+         if (!gm107_ubo_candidate(&cbufs[i])) continue;
+         selected = ctx->cbuf_map->cbuf_count++;
+         ctx->cbuf_map->cbufs[selected] = cbufs[i].key;
+         break;
+      }
+   }
+   gm107_report(ctx, cbufs, num_cbufs, selected);
    ralloc_free(ctx->cbufs);
    ctx->cbufs = NULL;
 }
