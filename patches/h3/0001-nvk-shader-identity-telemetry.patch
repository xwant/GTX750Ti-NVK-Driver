+/* Diagnostic identity only. Unlike the cache hash above, this canonicalizes
+ * specialization entries and excludes caller padding and unused data bytes.
+ * No compiler/cache semantics are changed.
+ */
+static int spec_entry_compare(const void *a, const void *b)
+{
+   uint32_t x = ((const VkSpecializationMapEntry *)a)->constantID;
+   uint32_t y = ((const VkSpecializationMapEntry *)b)->constantID;
+   return (x > y) - (x < y);
+}
+static void identity_word(struct mesa_blake3 *h, uint64_t v)
+{
+   uint8_t le[8];
+   for (unsigned i = 0; i < 8; i++) le[i] = v >> (8 * i);
+   _mesa_blake3_update(h, le, sizeof(le));
+}
+bool
+vk_pipeline_shader_source_identity(const VkPipelineShaderStageCreateInfo *info,
+                                    blake3_hash out)
+{
+   struct mesa_blake3 h;
+   _mesa_blake3_init(&h);
+   memset(out, 0, BLAKE3_OUT_LEN);
+   const char domain[] = "vk.shader.source.v1";
+   _mesa_blake3_update(&h, domain, sizeof(domain));
+   VK_FROM_HANDLE(vk_shader_module, module, info->module);
+   const VkShaderModuleCreateInfo *minfo =
+      vk_find_struct_const(info->pNext, SHADER_MODULE_CREATE_INFO);
+   if (module) {
+      _mesa_blake3_update(&h, module->hash, sizeof(module->hash));
+   } else if (minfo) {
+      blake3_hash hash;
+      vk_shader_module_hash(minfo, hash);
+      _mesa_blake3_update(&h, hash, sizeof(hash));
+   } else {
+      /* Identifier-only modules and internal builtins have no recoverable
+       * original SPIR-V here. Emit an incomplete diagnostic, never invent it.
+       */
+      return false;
+   }
+   if (!info->pName) return false;
+   identity_word(&h, strlen(info->pName));
+   _mesa_blake3_update(&h, info->pName, strlen(info->pName));
+   identity_word(&h, info->stage);
+   identity_word(&h, info->flags);
+   identity_word(&h, get_required_subgroup_size(info));
+   const VkSpecializationInfo *spec = info->pSpecializationInfo;
+   uint32_t count = spec ? spec->mapEntryCount : 0;
+   identity_word(&h, count);
+   if (count) {
+      if (!spec->pMapEntries || !spec->pData || count > 4096)
+         return false;
+      VkSpecializationMapEntry *entries = malloc(count * sizeof(*entries));
+      if (!entries) return false;
+      memcpy(entries, spec->pMapEntries, count * sizeof(*entries));
+      qsort(entries, count, sizeof(*entries), spec_entry_compare);
+      for (uint32_t i = 0; i < count; i++) {
+         const VkSpecializationMapEntry *e = &entries[i];
+         if ((i && e->constantID == entries[i-1].constantID) ||
+             e->offset > spec->dataSize || e->size > spec->dataSize - e->offset) {
+            free(entries); return false;
+         }
+         identity_word(&h, e->constantID); identity_word(&h, e->size);
+         _mesa_blake3_update(&h, (const char *)spec->pData + e->offset, e->size);
+      }
+      free(entries);
+   }
+   _mesa_blake3_final(&h, out);
+   return true;
+}
