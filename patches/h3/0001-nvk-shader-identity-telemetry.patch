+   VkSpecializationMapEntry swap=map[0];map[0]=map[1];map[1]=swap;
+   data[2]++; /* Unused bytes and map order cannot alter identity. */
+   CHECK(vk_pipeline_shader_source_identity(&info,b)); CHECK(!memcmp(a,b,32));
+   data[0]++;
